POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ds10_cas_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

JWT_SECRET_KEY=change_me_to_a_random_secret

# --- TLS (optional, see cas_server/server.py) ---
# Unset = insecure port, same as before. Set both to enable TLS.
# GRPC_TLS_CERT_FILE=C:\CAS_Server\certs\server.crt
# GRPC_TLS_KEY_FILE=C:\CAS_Server\certs\server.key
# Optional, only with the two above: require+verify client certs (mutual TLS).
# GRPC_TLS_CLIENT_CA_FILE=C:\CAS_Server\certs\ca.crt

# --- Salud de la conexion (keepalive HTTP/2) ---
# Contraparte de los mismos ajustes en cas_client/.env. El critico es el
# tercero: gRPC descarta por defecto los PING que lleguen mas seguido que
# cada 300000 ms (5 min) y responde GOAWAY/ENHANCE_YOUR_CALM, cortando la
# conexion del cliente que intenta mantenerla viva. Tiene que quedar POR
# DEBAJO de GRPC_KEEPALIVE_TIME_MS del cliente.
# GRPC_KEEPALIVE_TIME_MS=30000
# GRPC_KEEPALIVE_TIMEOUT_MS=10000
# GRPC_MIN_PING_INTERVAL_WITHOUT_DATA_MS=10000
