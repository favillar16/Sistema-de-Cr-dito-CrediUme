POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ds10_cas_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

JWT_SECRET_KEY=change_me_to_a_random_secret

# --- TLS (optional, see cas_server/server.py) ---
# Unset = insecure port, same as before. Set both to enable TLS.
# GRPC_TLS_CERT_FILE=C:\CAS_Server\certs\server.crt
# GRPC_TLS_KEY_FILE=C:\CAS_Server\certs\server.key
# Optional, only with the two above: require+verify client certs (mutual TLS).
# GRPC_TLS_CLIENT_CA_FILE=C:\CAS_Server\certs\ca.crt
