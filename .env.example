# Root template documenting the env vars used across the project.
# In practice: copy the relevant vars into cas_server/.env (server reads it)
# and cas_client/.env (client only needs GRPC_HOST/GRPC_PORT).

# --- Database (cas_server) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ds10_cas_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- gRPC server (cas_server binds here, cas_client connects here) ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# --- Client-side: which host to dial (usually the server's LAN IP) ---
GRPC_SERVER_HOST=127.0.0.1

# --- Auth ---
JWT_SECRET_KEY=change_me_to_a_random_secret

# --- TLS (optional; unset = insecure, same behavior as before) ---
# Server (cas_server/.env): GRPC_TLS_CERT_FILE, GRPC_TLS_KEY_FILE, and
# optionally GRPC_TLS_CLIENT_CA_FILE for mutual TLS.
# Client (cas_client/.env): GRPC_TLS_CA_FILE, and optionally
# GRPC_TLS_CLIENT_CERT_FILE/GRPC_TLS_CLIENT_KEY_FILE for mutual TLS.
# See each package's own .env.example for the full detail.
