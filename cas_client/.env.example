# En una PC de uso mixto (servidor + cliente en la misma maquina), dejar
# 127.0.0.1 -- el .vbs de "Iniciar Servidor" ya inicia ambos localmente.
# En una PC de solo-cliente, apuntar al NOMBRE DE RED de la PC servidor
# (ej. DESKTOP-5H7BABS) en vez de su IP -- la IP LAN viene por DHCP y puede
# cambiar en cualquier renovacion de lease, rompiendo la conexion y el TLS
# (el certificado del servidor firma tanto ese hostname como una IP fija
# como Subject Alternative Name; si la IP real cambia, el SAN queda
# obsoleto). En esta red el hostname lo resuelve el DNS del propio router
# (192.168.100.1 registra lo que entrega por DHCP), asi que se actualiza
# solo; probar con "ping DESKTOP-5H7BABS" desde la PC cliente antes de usar
# la app. Solo si eso no resuelve, usar como respaldo la IP RESERVADA del
# servidor -- la que figura en certs/openssl.cnf, no la que tenga hoy; ver
# la seccion "Reserva DHCP" de docs/CONFIGURACION_CLIENTE_LAN.md.
# Usar el .vbs de solo-cliente en la PC cliente (no el de servidor). Los
# .vbs viven en la maquina de despliegue, no en el repo; si todavia se
# llaman "...CrediUME.vbs", es el nombre viejo de la entidad (hoy
# CREDIMED UME) -- renombrarlos es una tarea de despliegue.
GRPC_SERVER_HOST=DESKTOP-5H7BABS
GRPC_PORT=50051

# --- TLS (optional, see cas_client/grpc_client.py) ---
# Unset = insecure channel, same as before. Set to the server's CA/cert to
# trust it and dial over TLS -- must match what the server enabled in
# cas_server/.env (GRPC_TLS_CERT_FILE/GRPC_TLS_KEY_FILE). Copy the server's
# certs\server.crt file to the client PC and point this at that copy.
# GRPC_TLS_CA_FILE=C:\CredimedUme\certs\ca.crt
# Optional, only if the server requires mutual TLS (GRPC_TLS_CLIENT_CA_FILE
# set on the server) -- this client's own certificate/key.
# GRPC_TLS_CLIENT_CERT_FILE=C:\CredimedUme\certs\client.crt
# GRPC_TLS_CLIENT_KEY_FILE=C:\CredimedUme\certs\client.key

# --- Salud de la conexion (keepalive HTTP/2) ---
# Solo hace falta tocarlos si la red de destino corta las conexiones ociosas
# mas rapido que el intervalo por defecto (30 s). Bajar GRPC_KEEPALIVE_TIME_MS
# hace que el corte se detecte antes, pero OBLIGA a bajar tambien
# GRPC_MIN_PING_INTERVAL_WITHOUT_DATA_MS en cas_server/.env por debajo de ese
# valor: si el cliente hace ping mas seguido de lo que el servidor tolera, el
# servidor le corta la conexion a proposito (GOAWAY / ENHANCE_YOUR_CALM), que
# es justo el problema que el keepalive viene a resolver.
# GRPC_KEEPALIVE_TIME_MS=30000
# GRPC_KEEPALIVE_TIMEOUT_MS=10000
# Techo por llamada, en segundos. Si el servidor no contesta en este plazo la
# operacion falla con "Sin conexion" en vez de quedarse colgada.
# GRPC_CALL_TIMEOUT_SECONDS=20
