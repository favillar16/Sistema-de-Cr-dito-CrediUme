# Secrets -- real values live in *.env, examples stay tracked
*.env
!*.env.example

# TLS certs/keys generated on the deployment machine
certs/

# Server runtime logs on the deployment machine
logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Generated loan documents (walkthrough/demo output, not source)
contrato_*.pdf
liquidacion_*.pdf
pagare_*.pdf
cronograma_*.pdf
contrato_*.docx
liquidacion_*.docx
pagare_*.docx
cronograma_*.docx
comprobante_*.pdf
comprobante_*.docx
reporte_*.pdf
reporte_*.docx
estado_de_pago_*.pdf
estado_de_pago_*.docx

# Editor/OS cruft
.vscode/
.idea/
Thumbs.db
.DS_Store

# Third-party reference documents with a real person's PII (name/national
# ID/address/signature) and another institution's data -- kept locally only
# as a structural reference for cas_client/documents.py, never published.
docs/contrato.pdf
docs/pagare credi ume.docx
# Mismo criterio: fotos de la pantalla de otra institución, usadas como
# referencia de cómo debían funcionar los cargos capitalizados (BR-LOAN-006).
# El texto del requerimiento sí se versiona; las capturas no.
docs/cambios finales/*.jpg
docs/cambios finales/*.png

# Respaldos de base de datos (pg_dump) -- contienen datos reales de clientes
backups/
